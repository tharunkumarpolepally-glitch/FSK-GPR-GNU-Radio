    samp_rate: samp_rate
    time_source_rx: '''mimo'''
    time_source_tx: '''none'''
    timeout_rx: '0.1'
    timeout_tx: '0.1'
    wait_rx: '0.05'
    wait_tx: '0.05'
    wire_rx: ''''''
    wire_tx: ''''''
  states:
